/dts-v1/;
/plugin/;

#define RASPITE_HVT
#define RASPITE_WPC
#include "raspite.dtsi"

&chosen {
	version = "hvt";
};

&pio {
	ovp_en0: ovp_en0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO51__FUNC_GPIO51>;
			slew-rate = <1>;
			output-low;
		};
	};

	ovp_en1: ovp_en1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO51__FUNC_GPIO51>;
			slew-rate = <1>;
			output-high;
		};
	};
};

&i2c9 {
	aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa";
		spk-kpa-5v-en-gpios = <&pio 57 GPIO_ACTIVE_HIGH>;
		reg = <0x58>;
		dev_index = <0>;
		status = "okay";
	};

	aw87xxx_pa@59 {
		compatible = "awinic,aw87xxx_pa";
		spk-kpa-5v-en-gpios = <&pio 57 GPIO_ACTIVE_HIGH>;
		reg = <0x59>;
		dev_index = <1>;
		status = "okay";
	};
};

&mt6370_chg {
	enable_iaicr_cal;
};

&thermal_zones {
	mux_9221 {
		status = "okay";
	};

	p9221_sensor {
		status = "okay";
	};

	Wireless {
		status = "okay";
	};
};
