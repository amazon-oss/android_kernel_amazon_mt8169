	mmqos: interconnect {
		compatible = "mediatek,mt8169-mmqos";
		#interconnect-cells = <1>;
		mediatek,larbs = <&larb0>,
		                 <&larb1>,
		                 <&larb2>,
		                 <&larb4>,
		                 <&larb7>,
		                 <&larb8>,
		                 <&larb9>,
		                 <&larb11>,
		                 <&larb13>,
		                 <&larb14>,
		                 <&larb16>,
		                 <&larb17>,
		                 <&larb19>,
		                 <&larb20>;
		mediatek,commons = <&smi_common>;
		clocks = <&topckgen CLK_TOP_DISP_SEL>;
		clock-names = "mm";
		interconnects = <&dvfsrc MT8169_MASTER_MMSYS>,
		                <&dvfsrc MT8169_SLAVE_DDR_EMI>,
		                <&dvfsrc MT8169_MASTER_HRT_MMSYS>,
		                <&dvfsrc MT8169_SLAVE_HRT_DDR_EMI>;
