		         <&iommu0 M4U_PORT_L4_HW_VDEC_TILE_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_VDEC_VLD_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_VDEC_VLD2_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_VDEC_AVC_MV_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_VDEC_UFO_ENC_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_VDEC_RG_CTRL_DMA_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_MINI_MDP_R0_EXT>,
		         <&iommu0 M4U_PORT_L4_HW_MINI_MDP_W0_EXT>;
		mediatek,larbs = <&larb4>;
		interrupts = <0 343 4 0>;
