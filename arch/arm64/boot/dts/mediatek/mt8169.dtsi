		compatible = "mediatek,mdp_rdma0", "mediatek,mt8169-mdp-rdma", "mediatek,mt8169-mdp",
		             "mediatek,mdp1";
		reg = <0 0x1b003000 0 0x1000>;
		clocks = <&mdpsys CLK_MDP_RDMA0>,
		         <&topckgen CLK_TOP_MDP_SEL>,
		         <&mdpsys CLK_MDP_IMG_DL_ASYNC0>,
		         <&mdpsys CLK_MDP_IMG_DL_ASYNC1>,
		         <&mdpsys CLK_MDP_SMI0>,
		         <&mdpsys CLK_MDP_APB_BUS>,
		         <&mdpsys CLK_MDP_MUTEX0>,
		         <&mdpsys CLK_MDP_FAKE_ENG0>,
		         <&mdpsys CLK_MDP_IMG_DL_RELAY0_ASYNC0>,
		         <&mdpsys CLK_MDP_IMG_DL_RELAY1_ASYNC1>;
		mediatek,mdpid = <0>;
		clock-names = "MDP_RDMA0", "MDP_SEL", "IMG_DL_ASYNC0", "IMG_DL_ASYNC1", "MDP_SMI0",
		              "MDP_APB_BUS", "MDP_MUTEX0", "FAKE_ENG0", "IMG_DL_RELAY0",
		              "IMG_DL_RELAY1";
		iommus = <&iommu0 M4U_PORT_L2_MDP_RDMA0>,
		         <&iommu0 M4U_PORT_L2_MDP_WROT0>,
		         <&iommu0 M4U_PORT_L2_MDP_WROT1>;
		dma-ranges = <0x2 0 0 0x40000000 0x1 0>;
		mediatek,dma_mask_bit = <34>;
		mediatek,larbs = <&larb2>;
		mediatek,vcu = <&mdp_vcu>;
		mmsys_config = <&mdpsys_config>;
		mm_mutex = <&mdp_mutex0>;
		mboxes = <&gce_mbox 20 0 CMDQ_THR_PRIO_1>;
		mdp_rdma0 = <&mdp_rdma0>;
		mdp_rsz0 = <&mdp_rsz0>;
		mdp_rsz1 = <&mdp_rsz1>;
		mdp_wrot0 = <&mdp_wrot0>;
		mdp_wrot1 = <&mdp_wrot1>;
		mdp_tdshp0 = <&mdp_tdshp0>;
		mdp_color0 = <&mdp_color0>;
		mdp_aal0 = <&mdp_aal0>;
		mdp_hdr0 = <&mdp_hdr0>;
		thread_count = <24>;
		mediatek,mailbox-gce = <&gce_mbox>;
		mmsys_config_base = <0x14000000 0x1 0xffff0000>;
		gce-event-names = "rdma0_sof", "rdma1_sof", "rsz0_sof", "rsz1_sof", "tdshp0_sof",
		                  "wrot0_sof", "wrot1_sof", "rdma0_done", "rdma1_done", "wrot0_done",
		                  "wrot1_done", "wrot0_sram_ready", "wrot1_sram_ready";
		gce-events = <&gce_mbox CMDQ_EVENT_MDP_RDMA0_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_RDMA1_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_RSZ0_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_RSZ1_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_TDSHP0_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_WROT0_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_WROT1_SOF>,
		             <&gce_mbox CMDQ_EVENT_MDP_RDMA0_FRAME_DONE>,
		             <&gce_mbox CMDQ_EVENT_MDP_RDMA1_FRAME_DONE>,
		             <&gce_mbox CMDQ_EVENT_MDP_WROT0_FRAME_DONE>,
		             <&gce_mbox CMDQ_EVENT_MDP_WROT1_FRAME_DONE>,
		             <&gce_mbox 710>,
		             <&gce_mbox 711>;
	};

