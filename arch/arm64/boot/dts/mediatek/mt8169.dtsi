	disable_unused: disable_unused {
		compatible = "simple-bus";
		status = "okay";

		disable-unused-clk-ipesys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <&ipesys CLK_IPE_LARB19>,
			         <&ipesys CLK_IPE_LARB20>,
			         <&ipesys CLK_IPE_SMI_SUBCOM>,
			         <&ipesys CLK_IPE_FD>,
			         <&ipesys CLK_IPE_FE>,
			         <&ipesys CLK_IPE_RSC>,
			         <&ipesys CLK_IPE_DPE>,
			         <&ipesys CLK_IPE_GALS_IPE>;
			power-domains = <&spm MT8169_POWER_DOMAIN_IPE>;
		};

		disable-unused-clk-mdpsys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <&mdpsys CLK_MDP_RDMA0>,
			         <&mdpsys CLK_MDP_TDSHP0>,
			         <&mdpsys CLK_MDP_IMG_DL_ASYNC0>,
			         <&mdpsys CLK_MDP_IMG_DL_ASYNC1>,
			         <&mdpsys CLK_MDP_DISP_RDMA>,
			         <&mdpsys CLK_MDP_HMS>,
			         <&mdpsys CLK_MDP_SMI0>,
			         <&mdpsys CLK_MDP_APB_BUS>,
			         <&mdpsys CLK_MDP_WROT0>,
			         <&mdpsys CLK_MDP_RSZ0>,
			         <&mdpsys CLK_MDP_HDR0>,
			         <&mdpsys CLK_MDP_MUTEX0>,
			         <&mdpsys CLK_MDP_WROT1>,
			         <&mdpsys CLK_MDP_RSZ1>,
			         <&mdpsys CLK_MDP_FAKE_ENG0>,
