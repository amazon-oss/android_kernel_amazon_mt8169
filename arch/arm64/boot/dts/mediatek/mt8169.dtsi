#include <dt-bindings/clock/mt8169-clk.h>
#include <dt-bindings/power/mt8169-power.h>
#include <dt-bindings/memory/mt8169-larb-port.h>
#include <dt-bindings/interconnect/mtk,mt8169-emi.h>
#include <dt-bindings/gce/mt8169-gce.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "MT8169";
	compatible = "mediatek,MT8169";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		mdp_rdma0 = "/mdp_rdma0@1b003000";
		mdp_hdr0 = "/mdp_hdr0@1b007000";
		mdp_aal0 = "/mdp_aal0@1b005000";
		mdp_rsz0 = "/mdp_rsz0@1b008000";
		mdp_rsz1 = "/mdp_rsz1@1b009000";
		mdp_tdshp0 = "/mdp_tdshp0@1b00c000";
		mdp_color0 = "/mdp_color0@1b00e000";
		mdp_wrot0 = "/mdp_wrot0@1b00a000";
		mdp_wrot1 = "/mdp_wrot1@1b00b000";
		mdp_hms = "/mdp_hms@1b00d000";
		mdp_disp_rdma = "/mdp_disp_rdma@1b004000";
		mdp_disp_wdma = "/mdp_disp_wdma@1b006000";
		mdp_mutex0 = "/mdp_mutex0@1b001000";
		i2c0 = "/i2c0@11007000";
		i2c1 = "/i2c1@11008000";
		i2c2 = "/i2c2@11009000";
		i2c3 = "/i2c3@0x1100f000";
		i2c4 = "/i2c4@11011000";
		i2c5 = "/i2c5@11016000";
		i2c6 = "/i2c6@1100d000";
		i2c7 = "/i2c7@11004000";
		i2c8 = "/i2c8@11005000";
		i2c9 = "/i2c9@11019000";
		ovl0 = "/disp_ovl0@14005000";
		ovl3 = "/disp_ovl0_2l@14006000";
		rdma0 = "/disp_rdma0@14007000";
		ccorr0 = "/disp_ccorr0@1400b000";
		mmc0 = "/mmc@11230000";
		mmc1 = "/mmc@11240000";
	};

	mmc_fixed_3v3: fixedregulator0 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		regulator-always-on;
	};

	mmc_fixed_1v8_io: fixedregulator1 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
		regulator-always-on;
	};

	mmc1_fixed_pwr: fixedregulator@2 {
		compatible = "regulator-fixed";
		regulator-name = "sdio_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		regulator-always-on;
	};

	mmc1_fixed_rst: fixedregulator@3 {
		compatible = "regulator-fixed";
		regulator-name = "sdio_rst";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
	};

	cci: cci {
		compatible = "mediatek,mt8169-cci";
		clocks = <&mcusys CLK_MCU_ARMPLL_BUS_SEL>,
		         <&topckgen CLK_TOP_MAINPLL>;
		clock-names = "cci", "intermediate";
		operating-points-v2 = <&cci_opp>;
	};

	cci_opp: opp_table2 {
		compatible = "operating-points-v2";
		opp-shared;
	};

	chosen: chosen {
		bootargs = "console=tty0 console=ttyS0,921600n1 root=/dev/ram vmalloc=400M \
				swiotlb=noforce firmware_class.path=/vendor/firmware";
		kaslr-seed = <0 0>;
	};

	cluster0_opp: opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
	};

	cluster1_opp: opp_table1 {
		compatible = "operating-points-v2";
		opp-shared;
	};

	cpus: cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff>;
			clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>,
			         <&topckgen CLK_TOP_MAINPLL>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <84>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@001 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff>;
			clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>,
			         <&topckgen CLK_TOP_MAINPLL>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <84>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@002 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff>;
			clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>,
			         <&topckgen CLK_TOP_MAINPLL>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <84>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@003 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff>;
			clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>,
			         <&topckgen CLK_TOP_MAINPLL>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <84>;
			#cooling-cells = <2>;
		};

		cpu4: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			clock-frequency = <2000000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &mcusysoff>;
			clocks = <&mcusys CLK_MCU_ARMPLL_LL_SEL>,
			         <&topckgen CLK_TOP_MAINPLL>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			dynamic-power-coefficient = <84>;
			#cooling-cells = <2>;
		};

		cpu_map: cpu-map {
			cluster0: cluster0 {
				core0 {
					cpu = <&cpu0>;
				};

				core1 {
					cpu = <&cpu1>;
				};

				core2 {
					cpu = <&cpu2>;
				};

				core3 {
					cpu = <&cpu3>;
				};

				core4 {
					cpu = <&cpu4>;
				};
			};
		};

		idle_states: idle-states {
			entry-method = "arm,psci";

			cpuoff_l: cpuoff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1600>;
			};

			cpuoff_b: cpuoff_b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <50>;
				exit-latency-us = <100>;
				min-residency-us = <1400>;
			};

			clusteroff_l: clusteroff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <2100>;
			};

			clusteroff_b: clusteroff_b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <100>;
				exit-latency-us = <250>;
				min-residency-us = <1900>;
			};

			mcusysoff: mcusysoff {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010002>;
				local-timer-stop;
				entry-latency-us = <300>;
				exit-latency-us = <1200>;
				min-residency-us = <2600>;
			};
		};
	};

	memory {
		device_type = "memory";
		reg = <0 0x40000000 0 0x3e605000>;
	};

	pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
	};

	dsu_pmu: dsu_pmu {
		compatible = "arm,dsu-pmu";
		interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
		cpus = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4>;
		limit_latency = <140>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			no-map;
			status = "okay";
			size = <0 0x110000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0 0x40000000 0 0x60000000>;
		};

		mrdump_cb_reserved_memory: mrdump_cb-reserved-memory {
			compatible = "mediatek,mt8169-mrdump_cb-reserved-memory";
			no-map;
			reg = <0 0x543f0000 0 0x2000>;
		};

		consys_mem: consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0 0x500000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		wifi_mem: wifi-reserve-memory {
			compatible = "shared-dma-pool";
			no-map;
			size = <0 0x600000>;
			alignment = <0 0x1000000>;
			alloc-ranges = <0 0x40000000 0 0x80000000>;
		};

		secure_wfd_reserved_memory: secure-wfd-reserved-memory {
			compatible = "shared-dma-pool";
			reusable;
		};
	};

	gic: interrupt-controller {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		#address-cells = <2>;
		#size-cells = <2>;
		#redistributor-regions = <1>;
		interrupt-parent = <&gic>;
		interrupt-controller;
		reg = <0 0xc000000 0 0x40000 0 0xc040000 0 0x200000>;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
	};

	clocks {
		clk_null: clk_null {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
		};

		clk12m: clk12m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12000000>;
		};

		clk26m: clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <26000000>;
		};

		clk13m: clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <13000000>;
		};

		clk32k: clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32000>;
		};
	};

	qos: qos@0010d000 {
		compatible = "mediatek,mt8169-qos";
		reg = <0 0x10d000 0 0x100>;
	};

	cm_mgr: cm_mgr@0c530000 {
		compatible = "mediatek,mt8169-cm_mgr";
		reg = <0 0xc530000 0 0x9000>;
		reg-names = "cm_mgr_base";
		interconnects = <&dvfsrc MT8169_MASTER_MCUSYS>,
		                <&dvfsrc MT8169_SLAVE_DDR_EMI>;
		interconnect-names = "cm-perf-bw";
		required-opps = <&dvfsrc_freq_opp0>,
		                <&dvfsrc_freq_opp1>,
		                <&dvfsrc_freq_opp2>,
		                <&dvfsrc_freq_opp3>,
		                <&dvfsrc_freq_opp4>,
		                <&dvfsrc_freq_opp5>;
		cm_mgr,cp_down = <100 100 100 100 100>;
		cm_mgr,cp_up = <140 100 140 100 140>;
		cm_mgr,dt_down = <3 0 0 0 0>;
		cm_mgr,dt_up = <0 0 0 0 0>;
		cm_mgr,vp_down = <100 100 100 100 100>;
		cm_mgr,vp_up = <100 100 100 100 100>;
	};

	mcusys: syscon@0c530000 {
		compatible = "mediatek,mt8169-mcusys", "syscon";
		reg = <0 0xc530000 0 0xa300>;
		#clock-cells = <1>;
	};

	topckgen: syscon@10000000 {
		compatible = "mediatek,mt8169-topckgen", "syscon";
		reg = <0 0x10000000 0 0x1000>;
		#clock-cells = <1>;
	};

	infracfg_ao: syscon@10001000 {
		compatible = "mediatek,mt8169-infracfg_ao", "syscon", "simple-mfd";
		reg = <0 0x10001000 0 0x1000>;
		#clock-cells = <1>;

		infracfg_rst: reset-controller {
			compatible = "ti,syscon-reset";
			#reset-cells = <1>;
			ti,reset-bits = <288 0 292 0 0 0 28 304 0 308 0 0 0 28>;
		};
	};

	pericfg: pericfg@10003000 {
		compatible = "mediatek,pericfg", "syscon";
		reg = <0 0x10003000 0 0x1000>;
	};

	pio: pinctrl@10005000 {
		compatible = "mediatek,mt8169-pinctrl";
		reg = <0 0x10005000 0 0x1000>,
		      <0 0x10002000 0 0x200>,
		      <0 0x10002200 0 0x200>,
		      <0 0x10002400 0 0x200>,
		      <0 0x10002600 0 0x200>,
		      <0 0x10002a00 0 0x200>,
		      <0 0x10002c00 0 0x200>,
		      <0 0x1000b000 0 0x1000>;
		reg-names = "gpio_base", "iocfg_lt_base", "iocfg_lm_base", "iocfg_lb_base",
		            "iocfg_bl_base", "iocfg_rb_base", "iocfg_rt_base", "eint";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pio 0 0 185>;
		interrupt-controller;
		interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
		#interrupt-cells = <2>;
	};

	scpsys: syscon@10006000 {
		compatible = "syscon", "simple-mfd";
		reg = <0 0x10006000 0 0x1000>;
		#power-domain-cells = <1>;

		spm: power-controller {
			compatible = "mediatek,mt8169-power-controller";
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <1>;

			mfg0: mfg0@0 {
				reg = <0>;
				clocks = <&topckgen CLK_TOP_MFG_SEL>;
				clock-names = "mfg00";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				mfg1@1 {
					reg = <0x1>;
					mediatek,infracfg = <&infracfg_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					mfg2@2 {
						reg = <0x2>;
						#power-domain-cells = <0>;
					};

					mfg3@3 {
						reg = <0x3>;
						#power-domain-cells = <0>;
					};
				};
			};

			nna@18 {
				reg = <0x12>;
				mediatek,infracfg = <&infracfg_ao>;
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				nna2@21 {
					reg = <0x15>;
					clocks = <&topckgen CLK_TOP_NNA2_SEL>;
					clock-names = "nna20";
					mediatek,infracfg = <&infracfg_ao>;
					mediatek,subcfg = <&nnasys>;
					#power-domain-cells = <0>;
				};

				nna1@20 {
					reg = <0x14>;
					clocks = <&topckgen CLK_TOP_NNA1_SEL>;
					clock-names = "nna10";
					mediatek,infracfg = <&infracfg_ao>;
					mediatek,subcfg = <&nnasys>;
					#power-domain-cells = <0>;
				};

				nna0@19 {
					reg = <0x13>;
					clocks = <&topckgen CLK_TOP_NNA_SEL>;
					clock-names = "nna00";
					mediatek,infracfg = <&infracfg_ao>;
					mediatek,subcfg = <&nnasys>;
					#power-domain-cells = <0>;
				};
			};

			adsp_ao@22 {
				reg = <0x16>;
				clocks = <&topckgen CLK_TOP_AUDIODSP_SEL>,
				         <&topckgen CLK_TOP_ADSP_BUS_SEL>;
				clock-names = "adsp_ao0", "adsp_ao1";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				adsp_infra@23 {
					reg = <0x17>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					adsp_top@24 {
						reg = <0x18>;
						mediatek,infracfg = <&infracfg_ao>;
						#power-domain-cells = <0>;
					};
				};
			};

			dis@6 {
				reg = <0x6>;
				clocks = <&topckgen CLK_TOP_DISP_SEL>,
				         <&topckgen CLK_TOP_MDP_SEL>,
				         <&mmsys CLK_MM_SMI_INFRA>,
				         <&mmsys CLK_MM_SMI_COMMON>,
				         <&mmsys CLK_MM_SMI_GALS>,
				         <&mmsys CLK_MM_SMI_IOMMU>;
				clock-names = "dis0", "dis1", "dis-0", "dis-1", "dis-2", "dis-3";
				mediatek,infracfg = <&infracfg_ao>;
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				vdec@14 {
					reg = <0xe>;
					clocks = <&topckgen CLK_TOP_VDEC_SEL>,
					         <&vdecsys CLK_VDEC_LARB1_CKEN>;
					clock-names = "vdec0", "vdec-0";
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};

				cam@10 {
					reg = <0xa>;
					clocks = <&topckgen CLK_TOP_CAM_SEL>,
					         <&topckgen CLK_TOP_SENINF_SEL>,
					         <&topckgen CLK_TOP_SENINF1_SEL>,
					         <&topckgen CLK_TOP_SENINF2_SEL>,
					         <&topckgen CLK_TOP_SENINF3_SEL>,
					         <&topckgen CLK_TOP_CAMTM_SEL>,
					         <&camsys CLK_CAM2MM_GALS>,
					         <&camsys CLK_CAM_LARB13>,
					         <&camsys CLK_CAM_LARB14>;
					clock-names = "cam0", "cam1", "cam2", "cam3", "cam4", "cam5", "cam-0", "cam-1", "cam-2";
					mediatek,infracfg = <&infracfg_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					cam_rawb@12 {
						reg = <0xc>;
						clocks = <&camsys_rawb CLK_CAM_RAWB_LARBX_RAWB>;
						clock-names = "cam_rawb-0";
						mediatek,smi = <&smi_cam1>;
						mediatek,larb = <&camsys_rawb>;
						#power-domain-cells = <0>;
					};

					cam_rawa@11 {
						reg = <0xb>;
						clocks = <&camsys_rawa CLK_CAM_RAWA_LARBX_RAWA>;
						clock-names = "cam_rawa-0";
						mediatek,smi = <&smi_cam0>;
						mediatek,larb = <&camsys_rawa>;
						#power-domain-cells = <0>;
					};
				};

				ipe@9 {
					reg = <0x9>;
					clocks = <&topckgen CLK_TOP_IPE_SEL>,
					         <&ipesys CLK_IPE_LARB19>,
					         <&ipesys CLK_IPE_LARB20>,
					         <&ipesys CLK_IPE_SMI_SUBCOM>,
					         <&ipesys CLK_IPE_GALS_IPE>;
					clock-names = "ipe0", "ipe-0", "ipe-1", "ipe-2", "ipe-3";
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};

				img@7 {
					reg = <0x7>;
					clocks = <&topckgen CLK_TOP_IMG1_SEL>,
					         <&imgsys1 CLK_IMG1_GALS_IMG1>,
					         <&imgsys1 CLK_IMG1_LARB9_IMG1>,
					         <&imgsys1 CLK_IMG1_LARB10_IMG1>;
					clock-names = "img0", "img-0", "img-1", "img-2";
					mediatek,infracfg = <&infracfg_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					img2@8 {
						reg = <0x8>;
						clocks = <&imgsys2 CLK_IMG2_LARB9_IMG2>;
						clock-names = "img2-0";
						mediatek,smi = <&smi_img0>;
						mediatek,larb = <&imgsys1 &imgsys2>;
						#power-domain-cells = <0>;
					};
				};

				venc@13 {
					reg = <0xd>;
					clocks = <&topckgen CLK_TOP_VENC_SEL>,
					         <&vencsys CLK_VENC_CKE1_VENC>;
					clock-names = "venc0", "venc-0";
					mediatek,infracfg = <&infracfg_ao>;
					#power-domain-cells = <0>;
				};

				wpe@15 {
					reg = <0xf>;
					mediatek,infracfg = <&infracfg_ao>;
					clocks = <&topckgen CLK_TOP_WPE_SEL>,
					         <&wpesys CLK_WPE_SMI_LARB8_CK_EN>,
					         <&wpesys CLK_WPE_SMI_LARB8_PCLK_EN>;
					clock-names = "wpe0", "wpe-0", "wpe-1";
					#power-domain-cells = <0>;
				};
			};

			csirx_top@17 {
				reg = <0x11>;
				clocks = <&topckgen CLK_TOP_SENINF_SEL>,
				         <&topckgen CLK_TOP_SENINF1_SEL>;
				clock-names = "csirx_top0", "csirx_top1";
				#power-domain-cells = <0>;
			};

			ssusb@4 {
				reg = <0x4>;
				clocks = <&topckgen CLK_TOP_SSUSB_XHCI_SEL>,
				         <&topckgen CLK_TOP_SSUSB_TOP_1P_SEL>,
				         <&topckgen CLK_TOP_SSUSB_XHCI_1P_SEL>,
				         <&topckgen CLK_TOP_USB_TOP_SEL>,
				         <&infracfg_ao CLK_INFRA_AO_SSUSB_TOP_REF_CK>;
				clock-names = "ssusb0", "ssusb1", "ssusb2", "ssusb3", "ssusb-0";
				#power-domain-cells = <0>;
			};

			ssusb_p1@5 {
				reg = <0x5>;
				clocks = <&topckgen CLK_TOP_SSUSB_XHCI_SEL>,
				         <&topckgen CLK_TOP_SSUSB_TOP_1P_SEL>,
				         <&topckgen CLK_TOP_SSUSB_XHCI_1P_SEL>,
				         <&topckgen CLK_TOP_USB_TOP_SEL>,
				         <&infracfg_ao CLK_INFRA_AO_SSUSB_TOP_P1_REF_CK>;
				clock-names = "ssusb_p10", "ssusb_p11", "ssusb_p12", "ssusb_p13", "ssusb_p1-0";
				#power-domain-cells = <0>;
			};

			conn_on@16 {
				reg = <0x10>;
				mediatek,infracfg = <&infracfg_ao>;
				#power-domain-cells = <0>;
			};
		};
	};

