		hrid = <48 52 56 60>;
		domain = "LCPU", "LCPU_SRAM", "MCU", "BCPU", "BCPU_SRAM", "GPU", "VSRAM_GPU",
		         "VSRAM_OTHERS", "VCORE", "VCORE_OFF", "VCORE_OFF_VSRAM_OTHERS";
		LCPU = <540 255 950 30 6 0>;
		LCPU_SRAM = <540 0xff00 1050 30 1 0>;
		MCU = <540 0xff0000 950 30 1 0>;
		BCPU = <544 255 950 30 2 0>;
		BCPU_SRAM = <544 0xff00 1050 30 1 0>;
		GPU = <548 255 950 30 2 0>;
		VSRAM_GPU = <548 0xff00 1050 30 1 0>;
		VSRAM_OTHERS = <536 0xff000000 900 30 1 0>;
		VCORE = <536 0xff0000 800 30 1 0>;
		VCORE_OFF_VSRAM_OTHERS = <536 0xff00 550 30 1 0>;
		VCORE_OFF = <536 255 550 30 1 0>;
	};

