		                  "disp_token_esd_eof0", "disp_rdma0_eof0", "disp_wdma0_eof0",
		                  "disp_token_stream_block0", "disp_token_cabc_eof0",
		                  "disp_wdma0_eof2", "disp_dsi0_sof0";
		gce-events = <&gce_mbox 434>,
		             <&gce_mbox 640>,
		             <&gce_mbox 671>,
		             <&gce_mbox CMDQ_EVENT_DSI0_TE_ENG_EVENT>,
		             <&gce_mbox 641>,
