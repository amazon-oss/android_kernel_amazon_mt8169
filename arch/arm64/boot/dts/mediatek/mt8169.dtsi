		power-domains = <&spm MT8169_POWER_DOMAIN_VDEC>;
		mediatek,vcu = <&vcu>;
		clocks = <&vdecsys CLK_VDEC_CKEN>;
		clock-names = "CORE_MT_CG_VDEC";
	};

	larb4: smi@1602e000 {
