		status = "disabled";
	};

	mmdvfs {
		compatible = "mediatek,mmdvfs";
		operating-points-v2 = <&opp_table_cam>;
		mediatek,support_mux = "cam", "disp", "img", "ipe", "mdp", "vdec", "venc";
		mediatek,mux_cam = "TOP_UNIVPLL_D2_D2", "TOP_UNIVPLL_D3", "TOP_MAINPLL_D2";
		mediatek,mux_disp = "TOP_UNIVPLL_D2_D2", "TOP_MMPLL", "TOP_MMPLL";
		mediatek,mux_img = "TOP_UNIVPLL_D2_D2", "TOP_MAINPLL_D3", "TOP_MAINPLL_D2";
		mediatek,mux_ipe = "TOP_UNIVPLL_D2_D2", "TOP_MAINPLL_D3", "TOP_MAINPLL_D2";
		mediatek,mux_mdp = "TOP_UNIVPLL_D2_D2", "TOP_MMPLL", "TOP_MMPLL";
		mediatek,mux_vdec = "TOP_UNIVPLL_D2_D2", "TOP_UNIVPLL_D3", "TOP_MAINPLL_D2";
		mediatek,mux_venc = "TOP_MAINPLL_D3", "TOP_MMPLL", "TOP_MMPLL";
		dvfsrc-vcore-supply = <&dvfsrc_vcore>;
		mediatek,support_hopping = "clk_mmpll_ck";
		mediatek,hopping_clk_mmpll_ck = <315000000 450000000 560000000>;
		mediatek,action = <1>;
		clocks = <&topckgen CLK_TOP_CAM_SEL>,
		         <&topckgen CLK_TOP_DISP_SEL>,
		         <&topckgen CLK_TOP_IMG1_SEL>,
		         <&topckgen CLK_TOP_IPE_SEL>,
		         <&topckgen CLK_TOP_MDP_SEL>,
		         <&topckgen CLK_TOP_VDEC_SEL>,
		         <&topckgen CLK_TOP_VENC_SEL>,
		         <&topckgen CLK_TOP_UNIVPLL_D2_D2>,
		         <&topckgen CLK_TOP_UNIVPLL_D3>,
		         <&topckgen CLK_TOP_MAINPLL_D2>,
		         <&topckgen CLK_TOP_MAINPLL_D3>,
		         <&topckgen CLK_TOP_MMPLL>,
		         <&apmixedsys CLK_APMIXED_MMPLL>;
		clock-names = "cam", "disp", "img", "ipe", "mdp", "vdec", "venc",
		              "TOP_UNIVPLL_D2_D2", "TOP_UNIVPLL_D3", "TOP_MAINPLL_D2",
		              "TOP_MAINPLL_D3", "TOP_MMPLL", "clk_mmpll_ck";
	};

	opp_table_cam: opp-table-cam {
		compatible = "operating-points-v2";

		opp-0 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <650000>;
		};

		opp-1 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt = <700000>;
		};

		opp-2 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <800000>;
		};
	};

