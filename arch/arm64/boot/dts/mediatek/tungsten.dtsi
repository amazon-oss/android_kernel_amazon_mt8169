	temp_t3_to_t4_charger_current = <3300000>;
	soc_exit_eoc = <96>;
	top_off_mode_cv = <4200000>;
	top_off_difference_full_cv = <2500>;
	normal_difference_full_cv = <500>;
	power_detection_en;
	aicl_trigger_iusb = <3000000>;
	aicl_trigger_ichg = <3000000>;
	adapter_9w_aicl_min = <1800000>;
	adapter_12w_aicl_min = <2400000>;
	adapter_5w_iusb_lim = <1000000>;
	adapter_7p5w_iusb_lim = <1500000>;
	adapter_9w_iusb_lim = <1800000>;
	adapter_12w_iusb_lim = <2400000>;
	adapter_15w_iusb_lim = <3000000>;
	dpm_cv_bat_vdiff_uv = <20000>;
	dpm_ibat_threshold_ma = <200>;
	dpm_state_count_max = <9>;
	dpm_rechg_low_soc_diff = <2>;
	dpm_input_cur_limit_ua = <300000>;
	dpm_charge_cur_limit_ua = <300000>;
	invchg_check_iusb_ua = <300000>;
	invchg_check_ichg_ua = <1000000>;
	invchg_check_mivr_uv = <4500000>;
	battery_cv_aging1 = <4200000>;
	top_off_mode_cv_aging1 = <4200000>;
	jeita_temp_above_t4_cv_aging1 = <4100000>;
	jeita_temp_t3_to_t4_cv_aging1 = <4100000>;
	jeita_temp_t2_to_t3_cv_aging1 = <4200000>;
	jeita_temp_t1_to_t2_cv_aging1 = <4200000>;
	jeita_temp_t0_to_t1_cv_aging1 = <4200000>;
	jeita_temp_below_t0_cv_aging1 = <4200000>;
	battery_cv_aging2 = <4000000>;
	top_off_mode_cv_aging2 = <0>;
	jeita_temp_above_t4_cv_aging2 = <4000000>;
	jeita_temp_t3_to_t4_cv_aging2 = <4000000>;
	jeita_temp_t2_to_t3_cv_aging2 = <4000000>;
	jeita_temp_t1_to_t2_cv_aging2 = <4000000>;
	jeita_temp_t0_to_t1_cv_aging2 = <4000000>;
	jeita_temp_below_t0_cv_aging2 = <4000000>;
};

&pdc {
	status = "disabled";
	gauge = <&mtk_gauge>;
};

&pd_adapter {
	status = "disabled";
};

&pio {
	gps_pins_default: gps_default {
	};

	gps_l1_lna_pins_ol: gps_l1_lna@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO29__FUNC_GPIO29>;
			output-low;
		};
	};

	gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO29__FUNC_GPS_L1_ELNA_EN>;
		};
	};

	gps_l1_lna_pins_oh: gps_l1_lna@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO29__FUNC_GPIO29>;
			output-high;
		};
	};

	i2c0_pins: i2c0 {
		pins_bus {
			pinmux = <PINMUX_GPIO128__FUNC_SDA0>,
			         <PINMUX_GPIO127__FUNC_SCL0>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c1_pins: i2c1 {
		pins_bus {
			pinmux = <PINMUX_GPIO130__FUNC_SDA1>,
			         <PINMUX_GPIO129__FUNC_SCL1>;
			bias-disable;
		};
	};

	i2c2_pins: i2c2 {
		pins_bus {
			pinmux = <PINMUX_GPIO132__FUNC_SDA2>,
			         <PINMUX_GPIO131__FUNC_SCL2>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c3_pins: i2c3 {
		pins_bus {
			pinmux = <PINMUX_GPIO134__FUNC_SDA3>,
			         <PINMUX_GPIO133__FUNC_SCL3>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c5_pins: i2c5 {
		pins_bus {
			pinmux = <PINMUX_GPIO138__FUNC_SDA5>,
			         <PINMUX_GPIO137__FUNC_SCL5>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c6_pins: i2c6 {
		pins_bus {
			pinmux = <PINMUX_GPIO140__FUNC_SDA6>,
			         <PINMUX_GPIO139__FUNC_SCL6>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	mt6370_pins_default: mt6370_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>;
			bias-pull-up;
			input-enable;
		};
	};
};

&gps {
	pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	status = "disabled";
};

&consys {
	pmic = <&pmic>;
};

&gpu_mali_opp {
	opp00 {
		opp-hz = /bits/ 64 <1000000000>;
		opp-microvolt = <950000>;
	};

	opp01 {
		opp-hz = /bits/ 64 <950000000>;
		opp-microvolt = <900000>;
	};

	opp02 {
		opp-hz = /bits/ 64 <900000000>;
		opp-microvolt = <850000>;
	};

	opp03 {
		opp-hz = /bits/ 64 <850000000>;
		opp-microvolt = <800000>;
	};

	opp04 {
		opp-hz = /bits/ 64 <796000000>;
		opp-microvolt = <781250>;
	};

	opp05 {
		opp-hz = /bits/ 64 <743000000>;
		opp-microvolt = <756250>;
	};

	opp06 {
		opp-hz = /bits/ 64 <690000000>;
		opp-microvolt = <737500>;
	};

	opp07 {
		opp-hz = /bits/ 64 <637000000>;
		opp-microvolt = <712500>;
	};

	opp08 {
		opp-hz = /bits/ 64 <586000000>;
		opp-microvolt = <700000>;
	};

	opp09 {
		opp-hz = /bits/ 64 <535000000>;
		opp-microvolt = <687500>;
	};

	opp10 {
		opp-hz = /bits/ 64 <484000000>;
		opp-microvolt = <668750>;
	};

	opp11 {
		opp-hz = /bits/ 64 <434000000>;
		opp-microvolt = <656250>;
	};

	opp12 {
		opp-hz = /bits/ 64 <400000000>;
		opp-microvolt = <643750>;
	};

	opp13 {
		opp-hz = /bits/ 64 <366000000>;
		opp-microvolt = <637500>;
	};

	opp14 {
		opp-hz = /bits/ 64 <332000000>;
		opp-microvolt = <625000>;
	};

	opp15 {
		opp-hz = /bits/ 64 <299000000>;
		opp-microvolt = <612500>;
