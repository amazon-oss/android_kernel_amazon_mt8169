&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";

	mt6370: mt6370@34 {
		compatible = "mediatek,subpmic_pmu";
		pinctrl-names = "default";
		pinctrl-0 = <&mt6370_pins_default>;
		reg = <0x34>;
		status = "okay";
	};

	usb_type_c_mtk: usb_type_c@4e {
		compatible = "mediatek,usb_type_c";
		reg = <0x4e>;
		status = "okay";
	};
};

&mt6370_chg {
	ichg = <3000000>;
	mivr = <4500000>;
	cv = <4400000>;
	ieoc = <400000>;
	safety_timer = <20>;
	ircmp_resistor = <50000>;
	ircmp_vclamp = <32000>;
	enable_iaicr_cal;
	iaicr_threshold = <1000000 1400000 2150000 2650000>;
	iaicr_itarget = <1000 1800 2500 2800>;
	aicl_vth_offset = <200000>;
	aicl_err_h = <200000>;
	aicl_err_l = <100000>;
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;
	status = "okay";

	ilitek@41 {
		compatible = "ilitek_hid-over-i2c";
		reg = <0x41>;
		irq-gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
		hid-descr-addr = <0>;
	};

	focaltech_Touch@38 {
		compatible = "focal_hid-over-i2c";
		reg = <0x38>;
		fts-reset-gpios = <&pio 150 GPIO_ACTIVE_HIGH>;
		irq-gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
		hid-descr-addr = <0>;
	};

	nt36523n@1 {
		compatible = "i2c-hid-of-nvt-ts";
		reg = <0x1>;
		hid-descr-addr = <0>;
		irq-gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
		novatek,reset-gpio = <&pio 150 GPIO_ACTIVE_HIGH>;
		novatek,wakeup-id = <10>;
		novatek,pen-support;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	status = "okay";

	gsensor1: gsensor@4c {
		compatible = "mediatek,mc3416";
		reg = <0x4c>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x4c 0 0 0>;
		direction = <5>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
	};

	gsensor2: gsensor@18 {
		compatible = "mediatek,stk8ba58";
		reg = <0x18>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x18 0 0 0>;
		direction = <5>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	status = "okay";

	alsps@53 {
		compatible = "mediatek,alsps";
		reg = <0x53>;
		interrupt-parent = <&pio>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		debounce = <7 0>;
		status = "okay";
		i2c_num = <3>;
		i2c_addr = <0x53 0 0 0>;
		polling_mode_ps = <0>;
		polling_mode_als = <1>;
		power_id = <0xffff>;
		power_vol = <0>;
		ratio = <90 132 300>;
		cal_factor = <353 372 392 391>;
		als_level = <0 1 1 7 15 15 100 1000 2000 3000 6000 10000 14000 18000 20000>;
		als_value = <40 40 90 90 160 160 225 320 640 1280 1280 2600 2600 2600 10240 10240>;
		ps_threshold_high = <900>;
		ps_threshold_low = <600>;
		is_batch_supported_ps = <0>;
		is_batch_supported_als = <0>;
	};
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";

	bias_ic@3e {
		compatible = "lcm_bias";
		reg = <0x3e>;
	};
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	status = "disabled";

	nt50358a@3e {
		compatible = "nt50358a";
		reg = <0x3e>;
	};
};

&mipi_tx_config {
	status = "okay";
};

&mfg0 {
	domain-supply = <&mt6358_vgpu_reg>;
};

&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	non-removable;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	supports-cqe;
	no-sd;
	no-sdio;
	cap-mmc-hw-reset;
	hs400-ds-delay = <73746>;
	mediatek,hs400-ds-dly3 = <20>;
	vmmc-supply = <&mt6358_vemc_reg>;
	vqmmc-supply = <&mt6358_vio18_reg>;
};

&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 15 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6358_vmch_reg>;
	vqmmc-supply = <&mt6358_vmc_reg>;
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_0>;
	mediatek,pad-select = <0>;
	status = "okay";
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_1>;
	mediatek,pad-select = <0>;
	status = "disabled";

	spidev1: spi@0 {
		compatible = "mediatek,spi-mt65xx-test";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_2>;
	mediatek,pad-select = <0>;
	status = "disabled";

	spidev2: spi@0 {
		compatible = "mediatek,spi-mt65xx-test";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&spi3 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_3>;
	mediatek,pad-select = <0>;
	status = "disabled";

	spidev3: spi@0 {
		compatible = "mediatek,spi-mt65xx-test";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&spi4 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_4>;
	mediatek,pad-select = <0>;
	status = "disabled";

	spidev4: spi@0 {
		compatible = "mediatek,spi-mt65xx-test";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&spi5 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi_pins_5>;
	mediatek,pad-select = <0>;
	status = "disabled";

	spidev5: spi@0 {
		compatible = "mediatek,spi-mt65xx-test";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

&pio {
	kpd_gpio: kpd_gpio {
		pins_cols {
			pinmux = <PINMUX_GPIO79__FUNC_KPCOL0>;
			input-enable;
			bias-pull-up = <101>;
		};

		pins_rows {
			pinmux = <PINMUX_GPIO81__FUNC_KPROW0>,
			         <PINMUX_GPIO82__FUNC_KPROW1>;
			output-low;
			bias-disable;
			status = "disabled";
		};
	};

	panel_pins_default: panel_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO98__FUNC_GPIO98>,
			         <PINMUX_GPIO150__FUNC_GPIO150>,
			         <PINMUX_GPIO152__FUNC_GPIO152>,
			         <PINMUX_GPIO153__FUNC_GPIO153>;
			slew-rate = <1>;
		};
	};

	te_pins_default: te_pins_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO96__FUNC_DSI_TE>;
			input-enable;
		};
	};

	pwm0_gpio_def_cfg: pwm0default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO97__FUNC_DISP_PWM>;
			output-high;
		};
	};

	spi_pins_0: spi0@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO36__FUNC_SPI0_CLK_A>,
			         <PINMUX_GPIO37__FUNC_SPI0_CSB_A>,
			         <PINMUX_GPIO38__FUNC_SPI0_MO_A>,
			         <PINMUX_GPIO39__FUNC_SPI0_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	ld_ctrl1_init: ldctrl1_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_ctrl1_low: ldctrl1_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-low;
		};
	};

	ld_ctrl1_high: ldctrl1_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection1_init: lddetection1_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection1_low: lddetection1_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-low;
		};
	};

	ld_detection1_high: lddetection1_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection2_init: lddetection2_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection2_low: lddetection2_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			slew-rate = <1>;
			output-low;
		};
	};

	ld_detection2_high: lddetection2_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			slew-rate = <1>;
			output-high;
		};
	};

	spi_pins_1: spi1@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO40__FUNC_SPI1_CLK_A>,
			         <PINMUX_GPIO41__FUNC_SPI1_CSB_A>,
			         <PINMUX_GPIO42__FUNC_SPI1_MO_A>,
			         <PINMUX_GPIO43__FUNC_SPI1_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_2: spi2@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO44__FUNC_SPI2_CLK_A>,
			         <PINMUX_GPIO45__FUNC_SPI2_CSB_A>,
			         <PINMUX_GPIO46__FUNC_SPI2_MO_A>,
			         <PINMUX_GPIO47__FUNC_SPI2_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_3: spi3@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO48__FUNC_SPI3_CLK>,
			         <PINMUX_GPIO49__FUNC_SPI3_CSB>,
			         <PINMUX_GPIO50__FUNC_SPI3_MO>,
			         <PINMUX_GPIO51__FUNC_SPI3_MI>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_4: spi4@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO10__FUNC_SPI4_CLK_A>,
			         <PINMUX_GPIO11__FUNC_SPI4_CSB_A>,
			         <PINMUX_GPIO12__FUNC_SPI4_MO_A>,
			         <PINMUX_GPIO13__FUNC_SPI4_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_5: spi5@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO52__FUNC_SPI5_CLK>,
			         <PINMUX_GPIO53__FUNC_SPI5_CSB>,
			         <PINMUX_GPIO54__FUNC_SPI5_MO>,
			         <PINMUX_GPIO55__FUNC_SPI5_MI>;
			bias-disable;
			input-enable;
		};
	};
};

&extcon_usb {
	status = "okay";
	vbus-current = <1300000>;

	port {
		mtu3_drd_switch: endpoint@0 {
			remote-endpoint = <&usb_role>;
		};
	};
};

&ssusb {
	dr_mode = "otg";
	maximum-speed = "high-speed";
	mediatek,force-vbus;
	mediatek,clk-mgr;
	usb-role-switch;
	status = "okay";

	port {
		usb_role: endpoint@0 {
			remote-endpoint = <&mtu3_drd_switch>;
		};
	};
};

&u2port0 {
	mediatek,eye-vrt = <7>;
	mediatek,eye-term = <7>;
	status = "okay";
};

&sound {
	compatible = "mediatek,mt8169-tungsten-sound";
	ext_amp1-gpios = <&pio 147 GPIO_ACTIVE_HIGH>;
	ext_amp2-gpios = <&pio 148 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default", "aud_clk_mosi_off", "aud_clk_mosi_on",
	                "aud_clk_miso_off", "aud_clk_miso_on", "aud_dat_miso_off",
	                "aud_dat_miso_on", "aud_dat_mosi_off", "aud_dat_mosi_on",
	                "aud_gpio_i2s0_off", "aud_gpio_i2s0_on", "aud_gpio_i2s1_off",
	                "aud_gpio_i2s1_on", "aud_gpio_i2s2_off", "aud_gpio_i2s2_on",
	                "aud_gpio_i2s3_off", "aud_gpio_i2s3_on", "aud_gpio_tdm_off",
	                "aud_gpio_tdm_on", "aud_gpio_pcm_off", "aud_gpio_pcm_on";
	pinctrl-0 = <&aud_default>;
	pinctrl-1 = <&aud_clk_mosi_off>;
	pinctrl-2 = <&aud_clk_mosi_on>;
	pinctrl-3 = <&aud_clk_miso_off>;
	pinctrl-4 = <&aud_clk_miso_on>;
	pinctrl-5 = <&aud_dat_miso_off>;
	pinctrl-6 = <&aud_dat_miso_on>;
	pinctrl-7 = <&aud_dat_mosi_off>;
	pinctrl-8 = <&aud_dat_mosi_on>;
	pinctrl-9 = <&aud_gpio_i2s0_off>;
	pinctrl-10 = <&aud_gpio_i2s0_on>;
	pinctrl-11 = <&aud_gpio_i2s1_off>;
	pinctrl-12 = <&aud_gpio_i2s1_on>;
	pinctrl-13 = <&aud_gpio_i2s2_off>;
	pinctrl-14 = <&aud_gpio_i2s2_on>;
	pinctrl-15 = <&aud_gpio_i2s3_off>;
	pinctrl-16 = <&aud_gpio_i2s3_on>;
	pinctrl-17 = <&aud_gpio_tdm_off>;
	pinctrl-18 = <&aud_gpio_tdm_on>;
	pinctrl-19 = <&aud_gpio_pcm_off>;
	pinctrl-20 = <&aud_gpio_pcm_on>;
	spk-pa-5v-en-gpios = <&pio 155 GPIO_ACTIVE_HIGH>;
	spk-pa-id-gpios = <&pio 25 GPIO_ACTIVE_HIGH>;
	apa-sdn-gpios = <&pio 61 GPIO_ACTIVE_HIGH>;
	mediatek,ext-spk-amp-vdd-on-time-us = <5000>;
	mediatek,headset-codec = <&accdet>;

	mediatek,audio-codec {
		sound-dai = <&mt6358codec>;
	};
