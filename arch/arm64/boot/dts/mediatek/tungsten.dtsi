&mtk_ctd {
	bc12 = <&mt6370_chg>;
};

&lk_charger {
	usb_charger_current = <500000>;
	ac_charger_current = <1200000>;
	ac_charger_input_current = <1000000>;
	non_std_ac_charger_current = <1000000>;
	charging_host_charger_current = <1500000>;
	fast_charge_voltage = <3100000>;
	precharge_current = <150000>;
	always_display;
	led_brightness = <10>;
	temp_t4_threshold = <55>;
	temp_t3_threshold = <45>;
	temp_t1_threshold = <15>;
	temp_t0_threshold = <0>;
	temp_t3_to_t4_input_current = <1000000>;
	temp_t3_to_t4_charger_current = <1200000>;
	temp_t0_to_t1_input_current = <1000000>;
	temp_t0_to_t1_charger_current = <500000>;
};

&charger {
	gauge = <&mtk_gauge>;
