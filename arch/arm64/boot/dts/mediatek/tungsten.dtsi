		mt6358rtc: mt6358rtc {
			compatible = "mediatek,mt6358-rtc";
			#address-cells = <1>;
			#size-cells = <1>;

			fg_init: fg_init {
				reg = <0 0x1>;
				bits = <0 8>;
			};

			fg_soc: fg_soc {
				reg = <0x1 0x1>;
				bits = <0 8>;
			};
		};

		pmic_key: pmic_key {
			compatible = "mediatek,mt6358-keys";
			power-off-time-sec = <2>;
			mediatek,long-press-mode = <1>;
			mediatek,volume-swap-key = <115>;
			bootmode = <&chosen>;

			power_key {
				linux,keycodes = <KEY_POWER>;
				wakeup-source;
			};

			home_key {
				linux,keycodes = <KEY_VOLUMEDOWN>;
			};
		};
