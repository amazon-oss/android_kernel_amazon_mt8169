&gpufreq {
	vgpu-supply = <&mt_pmic_vmodem_buck_reg>;
	vsram_gpu-supply = <&mt_pmic_vsram_others_ldo_reg>;
};

&thermal_zones {
	charge {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor1>;

		trips {
			charge_sysrst: charge_sysrst@0 {
				temperature = <100000>;
				hysteresis = <0>;
				type = "active";
			};

			charge_crit: charge_crit@0 {
				temperature = <90000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&charge_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pmic {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor2>;

		trips {
			pmic_sysrst: pmic_sysrst@0 {
				temperature = <100000>;
				hysteresis = <0>;
				type = "active";
			};

			pmic_crit: pmic_crit@0 {
				temperature = <90000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&pmic_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	mux_sd {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor3>;

		trips {
			mux_sd_sysrst: mux_sd_sysrst@0 {
				temperature = <90000>;
				hysteresis = <0>;
				type = "active";
			};

			mux_sd_crit: mux_sd_crit@0 {
				temperature = <80000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&mux_sd_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	mux_9221 {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor4>;
		status = "disabled";

		trips {
			mux_9221_sysrst: mux_9221_sysrst@0 {
				temperature = <100000>;
				hysteresis = <0>;
				type = "active";
			};

			mux_9221_crit: mux_9221_crit@0 {
				temperature = <90000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&mux_9221_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	p9221_sensor {
		polling-delay-passive = <0>;
		polling-delay = <3000>;
		thermal-sensors = <&p922x 0>;
		status = "disabled";
	};

	ap_ntc {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor5>;

		trips {
			ap_ntc_sysrst: ap_ntc_sysrst@0 {
				temperature = <100000>;
				hysteresis = <0>;
				type = "active";
			};

			ap_ntc_crit: ap_ntc_crit@0 {
				temperature = <90000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&ap_ntc_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pmic_t {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&pmic_temp 0>;

		trips {
			pmic_temp_sysrst: pmic_temp_sysrst@0 {
				temperature = <120000>;
				hysteresis = <0>;
				type = "active";
			};

			pmic_temp_crit: pmic_temp_crit@0 {
				temperature = <118000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&pmic_temp_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pmic_vcore {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&pmic_temp 1>;
	};

	pmic_vproc {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&pmic_temp 2>;
	};

	consys {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&consys>;

		trips {
			consys_max_sysrst: consys_max_sysrst@0 {
				temperature = <115000>;
				hysteresis = <2000>;
				type = "active";
			};

			consys_max_crit: consys_max_crit@0 {
				temperature = <113000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&consys_max_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	mtk-master-charger {
		polling-delay-passive = <3000>;
		polling-delay = <3000>;
		thermal-sensors = <&charger>;

		trips {
			mtk_charger_sysrst: mtk_charger_sysrst@0 {
				temperature = <120000>;
				hysteresis = <0>;
				type = "active";
			};

			mtk_master_charger_max_crit: mtk_master_charger_max_crit@0 {
				temperature = <118000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {
			map0 {
				trip = <&mtk_charger_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	Wireless {
		polling-delay-passive = <3000>;
		polling-delay = <3000>;
		thermal-sensors = <&p922x 1>;
		status = "disabled";

		trips {
			wireless_sysrst: wireless_sysrst@0 {
				temperature = <100000>;
				hysteresis = <0>;
				type = "active";
			};

			wireless_max_crit: wireless_max_crit@0 {
				temperature = <90000>;
				hysteresis = <0>;
				type = "critical";
			};

			wireless_stop_work: wireless_stop_work@0 {
				temperature = <65000>;
				hysteresis = <0>;
				type = "active";
			};
		};

		cooling-maps {
			map0 {
				trip = <&wireless_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};

			map1 {
				trip = <&wireless_stop_work>;
				cooling-device = <&wpc_bcct2 THERMAL_NO_LIMIT 1>;
			};
		};
	};
};

&charger {
	#thermal-sensor-cells = <0>;
};

&vdec {
	operating-points-v2 = <&opp_table_vdec>;
	dvfsrc-vcore-supply = <&dvfsrc_vcore>;
	interconnects = <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_MC_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_UFO_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_PP_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_PRED_RD_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_PRED_WR_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_PPWRAP_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_TILE_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_VLD_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_VLD2_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_AVC_MV_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_UFO_ENC_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_VDEC_RG_CTRL_DMA_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_MINI_MDP_R0_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L4_HW_MINI_MDP_W0_EXT)>,
	                <&mmqos SLAVE_COMMON(0)>;
	interconnect-names = "l4_mc", "l4_ufo", "l4_pp", "l4_pred_rd", "l4_pred_wr",
	                     "l4_ppwrap", "l4_tile", "l4_vld", "l4_vld2",
	                     "l4_avc_mv", "l4_ufo_enc", "l4_rdma", "l4_minimdp_r0",
	                     "l4_minimdp_w0";
};

&venc {
	operating-points-v2 = <&opp_table_venc>;
	dvfsrc-vcore-supply = <&dvfsrc_vcore>;
	interconnects = <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_RCPU)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_REC)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_BSDMA)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_SV_COMV)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_RD_COMV)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_CUR_LUMA)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_CUR_CHROMA)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_REF_LUMA)>,
	                <&mmqos SLAVE_COMMON(0)>,
	                <&mmqos MASTER_LARB_PORT(M4U_PORT_L7_VENC_REF_CHROMA)>,
	                <&mmqos SLAVE_COMMON(0)>;
	interconnect-names = "path_venc_rcpu", "path_venc_rec", "path_venc_bsdma",
	                     "path_venc_sv_comv", "path_venc_rd_comv",
	                     "path_venc_cur_luma", "path_venc_cur_chroma",
	                     "path_venc_ref_luma", "path_venc_ref_chroma";
};

&pio {
	camera_pins_cam0_rst_0: cam0@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO20__FUNC_GPIO20>;
			slew-rate = <1>;
			output-low;
		};
	};

	camera_pins_cam0_rst_1: cam0@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO20__FUNC_GPIO20>;
			slew-rate = <1>;
			output-high;
		};
	};

	camera_pins_cam0_pnd_0: cam0@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <1>;
			output-low;
		};
	};

	camera_pins_cam0_pnd_1: cam0@3 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			slew-rate = <1>;
			output-high;
		};
	};

	camera_pins_cam0_ldo_vcamd_0: cam0@4 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO44__FUNC_GPIO44>;
			slew-rate = <1>;
			output-low;
		};
	};

	camera_pins_cam0_ldo_vcamd_1: cam0@5 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO44__FUNC_GPIO44>;
			slew-rate = <1>;
			output-high;
		};
	};

	camera_pins_cam1_rst_0: cam1@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_GPIO22>;
			slew-rate = <1>;
			output-low;
		};
	};

	camera_pins_cam1_rst_1: cam1@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_GPIO22>;
			slew-rate = <1>;
			output-high;
		};
	};

	camera_pins_cam1_pnd_0: cam1@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <1>;
			output-low;
		};
	};

	camera_pins_cam1_pnd_1: cam1@3 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_GPIO21>;
			slew-rate = <1>;
			output-high;
		};
	};

	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO124__FUNC_GPIO124>;
			drive-strength = <1>;
		};
	};

	camera_pins_cam0_mclk_2ma: camera_pins_cam0_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO124__FUNC_CMMCLK0>;
			drive-strength = <2>;
		};
	};

	camera_pins_cam0_mclk_4ma: camera_pins_cam0_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO124__FUNC_CMMCLK0>;
			drive-strength = <4>;
		};
	};

	camera_pins_cam0_mclk_6ma: camera_pins_cam0_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO124__FUNC_CMMCLK0>;
			drive-strength = <6>;
		};
	};

	camera_pins_cam0_mclk_8ma: camera_pins_cam0_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO124__FUNC_CMMCLK0>;
			drive-strength = <8>;
		};
	};

	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO125__FUNC_GPIO125>;
			drive-strength = <1>;
		};
	};

	camera_pins_cam1_mclk_2ma: camera_pins_cam1_mclk_2ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO125__FUNC_CMMCLK1>;
			drive-strength = <2>;
		};
	};

	camera_pins_cam1_mclk_4ma: camera_pins_cam1_mclk_4ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO125__FUNC_CMMCLK1>;
			drive-strength = <4>;
		};
	};

	camera_pins_cam1_mclk_6ma: camera_pins_cam1_mclk_6ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO125__FUNC_CMMCLK1>;
			drive-strength = <6>;
		};
	};

	camera_pins_cam1_mclk_8ma: camera_pins_cam1_mclk_8ma {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO125__FUNC_CMMCLK1>;
			drive-strength = <8>;
		};
	};

	camera_pins_default: camdefault {
	};

	i2c4_pins: i2c4 {
		pins_bus {
			pinmux = <PINMUX_GPIO136__FUNC_SDA4>,
			         <PINMUX_GPIO135__FUNC_SCL4>;
			drive-strength = <8>;
			bias-pull-up = <203>;
			input-enable;
		};
	};

	i2c8_pins: i2c8 {
		pins_bus {
			pinmux = <PINMUX_GPIO144__FUNC_SDA8>,
			         <PINMUX_GPIO143__FUNC_SCL8>;
			drive-strength = <8>;
			bias-pull-up = <203>;
			input-enable;
		};
	};
};

&kd_camera_hw1 {
	pinctrl-names = "default", "cam0_rst0", "cam0_rst1", "cam0_pnd0",
	                "cam0_pnd1", "cam1_rst0", "cam1_rst1", "cam1_pnd0",
	                "cam1_pnd1", "cam0_mclk_off", "cam0_mclk_2mA",
	                "cam0_mclk_4mA", "cam0_mclk_6mA", "cam0_mclk_8mA",
	                "cam1_mclk_off", "cam1_mclk_2mA", "cam1_mclk_4mA",
	                "cam1_mclk_6mA", "cam1_mclk_8mA", "cam0_ldo_vcamd_0",
	                "cam0_ldo_vcamd_1";
	pinctrl-0 = <&camera_pins_default>;
	pinctrl-1 = <&camera_pins_cam0_rst_0>;
	pinctrl-2 = <&camera_pins_cam0_rst_1>;
	pinctrl-3 = <&camera_pins_cam0_pnd_0>;
	pinctrl-4 = <&camera_pins_cam0_pnd_1>;
	pinctrl-5 = <&camera_pins_cam1_rst_0>;
	pinctrl-6 = <&camera_pins_cam1_rst_1>;
	pinctrl-7 = <&camera_pins_cam1_pnd_0>;
	pinctrl-8 = <&camera_pins_cam1_pnd_1>;
	pinctrl-9 = <&camera_pins_cam0_mclk_off>;
	pinctrl-10 = <&camera_pins_cam0_mclk_2ma>;
	pinctrl-11 = <&camera_pins_cam0_mclk_4ma>;
	pinctrl-12 = <&camera_pins_cam0_mclk_6ma>;
	pinctrl-13 = <&camera_pins_cam0_mclk_8ma>;
	pinctrl-14 = <&camera_pins_cam1_mclk_off>;
	pinctrl-15 = <&camera_pins_cam1_mclk_2ma>;
	pinctrl-16 = <&camera_pins_cam1_mclk_4ma>;
	pinctrl-17 = <&camera_pins_cam1_mclk_6ma>;
	pinctrl-18 = <&camera_pins_cam1_mclk_8ma>;
	pinctrl-19 = <&camera_pins_cam0_ldo_vcamd_0>;
	pinctrl-20 = <&camera_pins_cam0_ldo_vcamd_1>;
	cam0_vcama-supply = <&mt_pmic_vcama_ldo_reg>;
	cam0_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam1_vcama-supply = <&mt_pmic_vcama_ldo_reg>;
	cam1_vcamio-supply = <&mt_pmic_vcamio_ldo_reg>;
	cam0_enable_sensor = "gc02m1_raspite_raw_cxt_rear gc02m1_raspite_raw_jk_rear ov02b10_raspite_raw_sjc_rear gc5035_raspite_raw_lce_rear hi556_raspite_raw_hlt_rear sc202cs_raspite_raw_lce_rear sc520cs_raspite_raw_lce_rear gc05a2_raspite_raw_txd_rear";
	cam1_enable_sensor = "ov02b10_raspite_raw_cxt_front gc02m1_raspite_raw_jk_front ov02b10_raspite_raw_sjc_front gc02m3_raspite_raw_lce_front";
	status = "okay";
};

&i2c4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	clock-frequency = <400000>;

	mtk_camera_eeprom0: camera_eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};

	camera_main_mtk: camera_main@1a {
		compatible = "mediatek,camera_main";
		#thermal-sensor-cells = <0>;
		reg = <0x1a>;
		status = "okay";
	};
};

&i2c8 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_pins>;
	clock-frequency = <400000>;

	mtk_camera_eeprom1: camera_eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};

	camera_sub_mtk: camera_sub@1a {
		compatible = "mediatek,camera_sub";
		#thermal-sensor-cells = <0>;
		reg = <0x1a>;
		status = "okay";
	};
};
