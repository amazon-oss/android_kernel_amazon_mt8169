	public_adc_liquid: pubadc_liquid {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO48__FUNC_GPIO48>;
			slew-rate = <1>;
			output-high;
		};
	};
};

&extcon_usb {
	status = "okay";
	vbus-current = <1300000>;

	port {
		mtu3_drd_switch: endpoint@0 {
			remote-endpoint = <&usb_role>;
		};
	};
};

&ssusb {
	dr_mode = "otg";
	maximum-speed = "high-speed";
	mediatek,force-vbus;
	mediatek,clk-mgr;
	usb-role-switch;
	status = "okay";

	port {
		usb_role: endpoint@0 {
			remote-endpoint = <&mtu3_drd_switch>;
		};
	};
};

