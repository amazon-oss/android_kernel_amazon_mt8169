&pdc {
	status = "disabled";
	gauge = <&mtk_gauge>;
};

&pd_adapter {
	status = "disabled";
};

&pio {
	gps_pins_default: gps_default {
	};

	gps_l1_lna_pins_ol: gps_l1_lna@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO29__FUNC_GPIO29>;
			output-low;
		};
	};

	gps_l1_lna_pins_dsp_ctrl: gps_l1_lna@1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO29__FUNC_GPS_L1_ELNA_EN>;
		};
	};

	gps_l1_lna_pins_oh: gps_l1_lna@2 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO29__FUNC_GPIO29>;
			output-high;
		};
	};

	i2c0_pins: i2c0 {
		pins_bus {
			pinmux = <PINMUX_GPIO128__FUNC_SDA0>,
			         <PINMUX_GPIO127__FUNC_SCL0>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c1_pins: i2c1 {
		pins_bus {
			pinmux = <PINMUX_GPIO130__FUNC_SDA1>,
			         <PINMUX_GPIO129__FUNC_SCL1>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c2_pins: i2c2 {
		pins_bus {
			pinmux = <PINMUX_GPIO132__FUNC_SDA2>,
			         <PINMUX_GPIO131__FUNC_SCL2>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	i2c6_pins: i2c6 {
		pins_bus {
			pinmux = <PINMUX_GPIO140__FUNC_SDA6>,
			         <PINMUX_GPIO139__FUNC_SCL6>;
			bias-pull-up = <201>;
			input-enable;
		};
	};

	mt6370_pins_default: mt6370_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO1__FUNC_GPIO1>;
			bias-pull-up;
			input-enable;
		};
	};
};

