&vcu {
	mboxes = <&gce_mbox 7 0 CMDQ_THR_PRIO_1>,
	         <&gce_mbox 12 0 CMDQ_THR_PRIO_1>,
	         <&gce_mbox_sec 11 0 CMDQ_THR_PRIO_1>;
};

&pio {
	dsp_uart_pin: dsp_uart_pin {
		dsp_uart_pins {
			pinmux = <PINMUX_GPIO34__FUNC_ADSP_UART_RX>,
			         <PINMUX_GPIO35__FUNC_ADSP_UART_TX>;
		};
	};

	sgm2541_en_output0: sgmoutput0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO117__FUNC_GPIO117>;
			slew-rate = <1>;
			output-low;
		};
	};

	sgm2541_en_output1: sgmoutput1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO117__FUNC_GPIO117>;
			slew-rate = <1>;
			output-high;
		};
	};

	usbc_otg_en0: otg_en0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO116__FUNC_GPIO116>;
			slew-rate = <1>;
			output-low;
		};
	};

	usbc_otg_en1: otg_en1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO116__FUNC_GPIO116>;
			slew-rate = <1>;
			output-high;
		};
	};
};

&cci {
	proc-supply = <&mt_pmic_vproc_buck_reg>;
	sram-supply = <&mt_pmic_vsram_proc_ldo_reg>;
};

&chosen {
	bootargs_ext = "loglevel=8 androidboot.hardware=mt8169 clk_ignore_unused pd_ignore_unused";
	atag,videolfb-fb_base_l = "~`P";
	atag,videolfb-fb_base_h = <0>;
	atag,videolfb-islcmfound = <1>;
	atag,videolfb-islcm_inited = <0>;
	atag,videolfb-fps = <6000>;
	atag,videolfb-vramSize = <0x17e8000>;
	atag,videolfb-lcmname = "nt35695_fhd_dsi_cmd_truly_rt5081_drv";
};

&cpu0 {
	proc-supply = <&mt_pmic_vproc_buck_reg>;
	sram-supply = <&mt_pmic_vsram_proc_ldo_reg>;
};

&cpu1 {
	proc-supply = <&mt_pmic_vproc_buck_reg>;
	sram-supply = <&mt_pmic_vsram_proc_ldo_reg>;
};

