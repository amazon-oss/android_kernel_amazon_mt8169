&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <100000>;
	status = "okay";

	alsps@53 {
		compatible = "mediatek,alsps";
		reg = <0x53>;
		interrupt-parent = <&pio>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		debounce = <7 0>;
		pinctrl-names = "pin_default", "pin_cfg";
		pinctrl-0 = <&alsps_intpin_default>;
		pinctrl-1 = <&alsps_intpin_cfg>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x53 0 0 0>;
		polling_mode_ps = <0>;
		polling_mode_als = <1>;
		power_id = <0xffff>;
		power_vol = <0>;
		ratio = <89 126 300>;
		cal_factor = <337 374 374 460>;
		als_level = <0 1 1 7 15 15 100 1000 2000 3000 6000 10000 14000 18000 20000>;
		als_value = <40 40 90 90 160 160 225 320 640 1280 1280 2600 2600 2600 10240 10240>;
		ps_threshold_high = <900>;
		ps_threshold_low = <600>;
		is_batch_supported_ps = <0>;
		is_batch_supported_als = <0>;
	};

	gsensor1: gsensor@4c {
		compatible = "mediatek,mc3416";
		reg = <0x4c>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x4c 0 0 0>;
		direction = <5>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
#ifdef RASPITE_HVT
		is_direction_change = <1>;
#else
		is_direction_change = <0>;
#endif
		gpio_pin = <&pio 18 GPIO_ACTIVE_HIGH>;
	};

	gsensor2: gsensor@0F {
		compatible = "mediatek,stk8321";
		reg = <0xf>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0xf 0 0 0>;
		direction = <5>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
#ifdef RASPITE_HVT
		is_direction_change = <1>;
#else
		is_direction_change = <0>;
#endif
		gpio_pin = <&pio 18 GPIO_ACTIVE_HIGH>;
	};

	gsensor3: gsensor@18 {
		compatible = "mediatek,stk8ba58";
		reg = <0x18>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x18 0 0 0>;
		direction = <5>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
		is_direction_change = <0>;
		gpio_pin = <&pio 18 GPIO_ACTIVE_HIGH>;
	};

	fusb251@28 {
		status = "ok";
		compatible = "fusb251";
		reg = <0x28>;
		i2c_num = <2>;
		i2c_addr = <0x28 0 0 0>;
		threshold_sbu = <747 960>;
		threshold_sbuft = <100>;
		work_interval = <15 30 60>;
		det_delay = <100 1000>;
	};

	max20342@35 {
		status = "ok";
		compatible = "max20342";
		reg = <0x35>;
		i2c_num = <2>;
		i2c_addr = <0x35 0 0 0>;
		work_interval = <15 30 60>;
		det_delay = <300 300>;
		target_ipu = [01];
		target_resister = [64];
		ld_buffer = [56 77];
		target_voltage_max = [a3];
		target_adcgroundvth = [04];
	};
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	clock-frequency = <400000>;
	status = "okay";

	p922x: p922x@61 {
		compatible = "IDT,idt_wireless_power";
		reg = <0x61>;
		interrupt-parent = <&pio>;
		interrupts = <13 IRQ_TYPE_EDGE_FALLING>,
		             <154 IRQ_TYPE_EDGE_RISING>;
		wpc-mivr = <4500000 4500000>;
		wpc-switch-voltage = <4500 5000 5500 8500 9000 9500>;
#if defined(RASPITE_EVT) && defined(RASPITE_WPC)
		bpp-5w-fod = <0x9d23941a 0x9215940a 0x9a039af9 0x14140000>;
		bpp-10w-fod = <0x85418232 0x85298232 0x8cfe8712 0x14140000>;
#else
		bpp-5w-fod = <0x97329426 0x951c941a 0x941b951f 0xfe7f0000>;
		bpp-10w-fod = <0x824b8241 0x82418237 0x88148814 0xfe7f0000>;
#endif
#ifdef RASPITE_EVT
		pinctrl-names = "wpc_en0", "wpc_en1", "sleep_en0", "sleep_en1";
#else
		pinctrl-names = "wpc_en0", "wpc_en1", "sleep_en0", "sleep_en1", "ovp_en0", "ovp_en1";
#endif
		pinctrl-0 = <&wpc_en0>;
		pinctrl-1 = <&wpc_en1>;
		pinctrl-2 = <&sleep_en0>;
		pinctrl-3 = <&sleep_en1>;
		p922x-irq = <&pio 13 GPIO_ACTIVE_HIGH>;
		p922x-pg = <&pio 154 GPIO_ACTIVE_HIGH>;
		#thermal-sensor-cells = <1>;
		charger = <&charger>;
		gauge = <&mtk_gauge>;
		status = "okay";
#ifndef RASPITE_EVT
		pinctrl-4 = <&ovp_en0>;
		pinctrl-5 = <&ovp_en1>;
#endif
#if defined(RASPITE_EVT) && defined(RASPITE_WPC)
		adaptive_max_current_limit_ma = <1200>;
		step_max_ua = <1200000>;
#endif
	};
};

