	invchg_check_iusb_ua = <300000>;
	invchg_check_ichg_ua = <1000000>;
	invchg_check_mivr_uv = <4500000>;
	battery_cv_aging1 = <4300000>;
	top_off_mode_cv_aging1 = <4100000>;
	jeita_temp_above_t4_cv_aging1 = <4100000>;
	jeita_temp_t3_to_t4_cv_aging1 = <4100000>;
	jeita_temp_t2_to_t3_cv_aging1 = <4300000>;
	jeita_temp_t1_to_t2_cv_aging1 = <4300000>;
	jeita_temp_t0_to_t1_cv_aging1 = <4300000>;
