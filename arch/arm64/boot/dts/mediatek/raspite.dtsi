&pio {
	CTP_pins_default: eint0default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO0__FUNC_GPIO0>;
			bias-disable;
			input-schmitt-enable;
		};
	};

	CTP_pins_eint_as_int: eint@0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO0__FUNC_GPIO0>;
			input-enable;
			bias-disable;
			input-schmitt-enable;
		};
	};

	CTP_pins_eint_output0: eintoutput0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO0__FUNC_GPIO0>;
			output-low;
			input-schmitt-enable;
		};
	};

	CTP_pins_eint_output1: eintoutput1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO0__FUNC_GPIO0>;
			output-high;
			input-schmitt-enable;
		};
	};

	CTP_pins_rst_output0: rstoutput0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO150__FUNC_GPIO150>;
			output-low;
		};
	};

	CTP_pins_rst_output1: rstoutput1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO150__FUNC_GPIO150>;
			output-high;
		};
	};

	wpc_en0: wpc_en0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO54__FUNC_GPIO54>;
			slew-rate = <1>;
			output-low;
		};
	};

	wpc_en1: wpc_en1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO54__FUNC_GPIO54>;
			slew-rate = <1>;
			output-high;
		};
	};

	sleep_en0: sleep_en0 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO55__FUNC_GPIO55>;
			slew-rate = <1>;
			output-low;
		};
	};

	sleep_en1: sleep_en1 {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO55__FUNC_GPIO55>;
			slew-rate = <1>;
			output-high;
		};
	};

	pwm0_gpio_def_cfg: pwm0default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO97__FUNC_DISP_PWM>;
			output-high;
		};
	};

	kpd_gpio: kpd_gpio {
		pins_cols {
			pinmux = <PINMUX_GPIO80__FUNC_KPCOL1>,
			         <PINMUX_GPIO79__FUNC_KPCOL0>;
			input-enable;
			bias-pull-up = <101>;
		};

		pins_rows {
			pinmux = <PINMUX_GPIO81__FUNC_KPROW0>,
			         <PINMUX_GPIO82__FUNC_KPROW1>;
			output-low;
			bias-disable;
		};
	};

	spi_pins_0: spi0@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO36__FUNC_SPI0_CLK_A>,
			         <PINMUX_GPIO37__FUNC_SPI0_CSB_A>,
			         <PINMUX_GPIO38__FUNC_SPI0_MO_A>,
			         <PINMUX_GPIO39__FUNC_SPI0_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_1: spi1@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO40__FUNC_SPI1_CLK_A>,
			         <PINMUX_GPIO41__FUNC_SPI1_CSB_A>,
			         <PINMUX_GPIO42__FUNC_SPI1_MO_A>,
			         <PINMUX_GPIO43__FUNC_SPI1_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_2: spi2@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO44__FUNC_SPI2_CLK_A>,
			         <PINMUX_GPIO45__FUNC_SPI2_CSB_A>,
			         <PINMUX_GPIO46__FUNC_SPI2_MO_A>,
			         <PINMUX_GPIO47__FUNC_SPI2_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_3: spi3@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO48__FUNC_SPI3_CLK>,
			         <PINMUX_GPIO49__FUNC_SPI3_CSB>,
			         <PINMUX_GPIO50__FUNC_SPI3_MO>,
			         <PINMUX_GPIO51__FUNC_SPI3_MI>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_4: spi4@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO10__FUNC_SPI4_CLK_A>,
			         <PINMUX_GPIO11__FUNC_SPI4_CSB_A>,
			         <PINMUX_GPIO12__FUNC_SPI4_MO_A>,
			         <PINMUX_GPIO13__FUNC_SPI4_MI_A>;
			bias-disable;
			input-enable;
		};
	};

	spi_pins_5: spi5@0 {
		pins_spi {
			pinmux = <PINMUX_GPIO52__FUNC_SPI5_CLK>,
			         <PINMUX_GPIO53__FUNC_SPI5_CSB>,
			         <PINMUX_GPIO54__FUNC_SPI5_MO>,
			         <PINMUX_GPIO55__FUNC_SPI5_MI>;
			bias-disable;
			input-enable;
		};
	};

	ld_ctrl1_init: ldctrl1_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_ctrl1_low: ldctrl1_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-low;
		};
	};

	ld_ctrl1_high: ldctrl1_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection1_init: lddetection1_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection1_low: lddetection1_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-low;
		};
	};

	ld_detection1_high: lddetection1_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO59__FUNC_GPIO59>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection2_init: lddetection2_init {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			slew-rate = <1>;
			output-high;
		};
	};

	ld_detection2_low: lddetection2_low {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			slew-rate = <1>;
			output-low;
		};
	};

	ld_detection2_high: lddetection2_high {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			slew-rate = <1>;
			output-high;
		};
	};

	public_adc_bat_id: pubadc_bat_id {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO48__FUNC_GPIO48>;
			slew-rate = <1>;
			output-low;
		};
